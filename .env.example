# Copy to .env (never commit .env). Demo mode needs nothing.
# demo (default): synthetic data and a mock Consenzy principal API at /v1/me. live: call your Consenzy deployment.
CONSENZY_MODE=demo

# Live mode only. The org API key stays on this server; it needs the sessions:mint and consents:check scopes.
CONSENZY_BASE_URL=https://consenzy.onfinance.ai
CONSENZY_API_KEY=

# Customers this example may mint sessions for. Replace with your own authentication.
ALLOWED_EXTERNAL_REFS=CUST-DEMO-0001,CUST-DEMO-CHILD-7

# Demo mode: the URL apps should use for the mock API (default: the host the app called).
PUBLIC_URL=
PORT=8787
